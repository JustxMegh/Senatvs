# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Discord application (client) ID
CLIENT_ID=

# Optional: set this while developing to register commands instantly to one server
# instead of waiting up to 1 hour for global command propagation. Remove/leave blank
# for production so commands work across every server the bot is in.
DEV_GUILD_ID=

# MongoDB connection string (Railway will inject this automatically if you add a
# MongoDB plugin to your project, usually as MONGO_URL - map it to this name too)
MONGODB_URI=
